	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="UI\Dashboard\MainGUI.resx">
	    <DependentUpon>MainGUI.cs</DependentUpon>
	    <SubType>Designer</SubType>
	  </EmbeddedResource>
	  <EmbeddedResource Update="UI\ServerSetup\SteamAccountLoginDialog.resx">
	    <DependentUpon>SteamAccountLoginDialog.cs</DependentUpon>
	    <SubType>Designer</SubType>
	  </EmbeddedResource>
	  <EmbeddedResource Update="UI\ServerManagement\ServerBackupRestoreDialog.resx">
	    <DependentUpon>ServerBackupRestoreDialog.cs</DependentUpon>
	    <SubType>Designer</SubType>
	  </EmbeddedResource>
	  <EmbeddedResource Include="$(IntermediateOutputPath)synix-supported-languages.txt">
	    <LogicalName>Synix_Control_Panel.Localization.SupportedLanguages.txt</LogicalName>
	  </EmbeddedResource>
	</ItemGroup>

	<Target Name="GenerateSynixSupportedLanguageManifest" BeforeTargets="PrepareResourceNames">
		<PropertyGroup>
			<_SynixSupportedLanguageManifest>$(IntermediateOutputPath)synix-supported-languages.txt</_SynixSupportedLanguageManifest>
		</PropertyGroup>
		<ItemGroup>
			<_SynixLocalizedCatalog Include="$(MSBuildProjectDirectory)\Localization\Strings.*.resx" />
		</ItemGroup>
		<WriteLinesToFile File="$(_SynixSupportedLanguageManifest)" Lines="en-US;@(_SynixLocalizedCatalog->'%(Filename)')" Overwrite="true" Encoding="UTF-8" />
	</Target>

	<ItemGroup>
		<None Update="Images\SyniX logo with glowing accents.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Update="Properties\Settings.settings">
		  <Generator>SettingsSingleFileGenerator</Generator>
		  <LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<Target Name="BuildMsiAfterPublish" AfterTargets="Publish">
		<PropertyGroup>
			<_SynixPublishDirectory>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_SynixPublishDirectory>
			<_SynixPublishPathMarker>$([System.IO.Path]::Combine('$(_SynixPublishDirectory)', '_'))</_SynixPublishPathMarker>
			<_SynixPublishDirectory>$([System.IO.Path]::GetDirectoryName('$(_SynixPublishPathMarker)'))</_SynixPublishDirectory>
			<_SynixPublishedExe>$([System.IO.Path]::Combine('$(PublishDir)', '$(AssemblyName).exe'))</_SynixPublishedExe>
			<_SynixMsiProject>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Packaging', 'MSI', 'SynixInstaller.wixproj'))</_SynixMsiProject>
			<_SynixMsiBuildOutput>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Packaging', 'MSI', 'bin', 'Release', 'SynixSetup.msi'))</_SynixMsiBuildOutput>
			<_SynixMsiOutput>$([System.IO.Path]::Combine('$(PublishDir)', 'SynixSetup.msi'))</_SynixMsiOutput>
			<_SynixTestsProject>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Tests', 'Synix.Tests.csproj'))</_SynixTestsProject>
			<_SynixDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_SynixDotNetHost>
			<_SynixDotNetHost Condition="'$(_SynixDotNetHost)' == '' and '$(ProgramW6432)' != ''">$([System.IO.Path]::Combine('$(ProgramW6432)', 'dotnet', 'dotnet.exe'))</_SynixDotNetHost>
			<_SynixDotNetHost Condition="'$(_SynixDotNetHost)' == ''">$([System.IO.Path]::Combine('$(ProgramFiles)', 'dotnet', 'dotnet.exe'))</_SynixDotNetHost>
		</PropertyGroup>
		<Error Condition="'$(SynixBuildChannel)' != 'Stable'" Text="Synix Publish was not marked as a Stable release build." />
		<Error Condition="'$(RuntimeIdentifier)' != 'win-x64'" Text="Synix release publishing must target win-x64. Select a Synix Folder publish profile and try again." />
		<Error Condition="'$(SelfContained)' != 'true'" Text="Synix release publishing must be self-contained because SynixSetup.msi packages the single published EXE. The selected publish profile is incomplete." />
		<Error Condition="'$(PublishSingleFile)' != 'true'" Text="Synix release publishing must create a single EXE because SynixSetup.msi packages only that file. The selected publish profile is incomplete." />
		<Error Condition="!Exists('$(_SynixPublishedExe)')" Text="The published Synix executable was not found at $(_SynixPublishedExe)." />
		<Error Condition="!Exists('$(_SynixMsiProject)')" Text="The Synix MSI project was not found at $(_SynixMsiProject)." />
		<Error Condition="!Exists('$(_SynixTestsProject)')" Text="The Synix automated test project was not found at $(_SynixTestsProject)." />
		<Error Condition="!Exists('$(_SynixDotNetHost)')" Text="The 64-bit .NET host was not found at $(_SynixDotNetHost). Repair the Visual Studio .NET SDK before publishing." />
		<Message Text="Starting the published EXE in hidden smoke-test mode..." Importance="high" />
		<Exec Command="&quot;$(_SynixPublishedExe)&quot; --synix-publish-smoke-test" WorkingDirectory="$(_SynixPublishDirectory)" Timeout="30000" />
		<Message Text="Running the complete Synix automated test suite before packaging..." Importance="high" />
		<Exec Command="&quot;$(_SynixDotNetHost)&quot; test &quot;$(_SynixTestsProject)&quot; --configuration Release --logger &quot;console;verbosity=minimal&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<PropertyGroup>
			<_SynixAutomatedTestsUtc>$([System.DateTime]::UtcNow.ToString('O'))</_SynixAutomatedTestsUtc>
		</PropertyGroup>
		<Message Text="Building SynixSetup.msi with Version $(Version)..." Importance="high" />
		<Delete Files="$(_SynixMsiBuildOutput)" Condition="Exists('$(_SynixMsiBuildOutput)')" />
		<Exec Command="&quot;$(_SynixDotNetHost)&quot; build &quot;$(_SynixMsiProject)&quot; --configuration Release --no-incremental --nologo &quot;-p:Version=$(Version)&quot; &quot;-p:SynixPublishDir=$(_SynixPublishDirectory)&quot; &quot;-p:SynixProjectDir=$(MSBuildProjectDirectory)&quot; &quot;-p:SynixAssemblyName=$(AssemblyName)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Error Condition="!Exists('$(_SynixMsiBuildOutput)')" Text="WiX did not create $(_SynixMsiBuildOutput)." />
		<Delete Files="$(_SynixMsiOutput)" Condition="Exists('$(_SynixMsiOutput)')" />
		<Copy SourceFiles="$(_SynixMsiBuildOutput)" DestinationFiles="$(_SynixMsiOutput)" />
		<Error Condition="!Exists('$(_SynixMsiOutput)')" Text="The Synix MSI was not copied to $(_SynixMsiOutput)." />
		<Message Text="Synix MSI created at $(_SynixMsiOutput)." Importance="high" />
	</Target>

	<Target Name="WriteSynixReleaseManifest" AfterTargets="BuildMsiAfterPublish">
		<PropertyGroup>
			<_SynixPublishedExe>$([System.IO.Path]::Combine('$(PublishDir)', '$(AssemblyName).exe'))</_SynixPublishedExe>
			<_SynixMsiOutput>$([System.IO.Path]::Combine('$(PublishDir)', 'SynixSetup.msi'))</_SynixMsiOutput>
			<_SynixReleaseManifest>$([System.IO.Path]::Combine('$(PublishDir)', 'Synix.release-manifest.txt'))</_SynixReleaseManifest>
			<_SynixReleaseManifestBackup>$([System.IO.Path]::Combine('$(PublishDir)', 'Synix.release-manifest.backup.txt'))</_SynixReleaseManifestBackup>
		</PropertyGroup>
		<Error Condition="'$(_SynixAutomatedTestsUtc)' == ''" Text="The automated tests did not produce a passing release receipt." />
		<Error Condition="!Exists('$(_SynixPublishedExe)')" Text="The published Synix executable was not found at $(_SynixPublishedExe)." />
		<Error Condition="!Exists('$(_SynixMsiOutput)')" Text="The Synix MSI was not found at $(_SynixMsiOutput)." />
		<ItemGroup>
			<_SynixStandaloneFile Include="$(_SynixPublishedExe)" />
			<_SynixMsiFile Include="$(_SynixMsiOutput)" />
		</ItemGroup>
		<GetFileHash Files="@(_SynixStandaloneFile)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="_SynixStandaloneHashed" />
		</GetFileHash>
		<GetFileHash Files="@(_SynixMsiFile)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="_SynixMsiHashed" />
		</GetFileHash>
		<PropertyGroup>
			<_SynixStandaloneSha256>@(_SynixStandaloneHashed->'%(FileHash)')</_SynixStandaloneSha256>
			<_SynixMsiSha256>@(_SynixMsiHashed->'%(FileHash)')</_SynixMsiSha256>
		</PropertyGroup>
		<Error Condition="'$(_SynixStandaloneSha256)' == ''" Text="The standalone SHA-256 hash could not be created." />
		<Error Condition="'$(_SynixMsiSha256)' == ''" Text="The MSI SHA-256 hash could not be created." />
		<ItemGroup>
			<_SynixReleaseManifestLine Include="FormatVersion=3" />
			<_SynixReleaseManifestLine Include="Version=$(Version)" />
			<_SynixReleaseManifestLine Include="Channel=$(SynixBuildChannel)" />
			<_SynixReleaseManifestLine Include="AutomatedTests=Passed" />
			<_SynixReleaseManifestLine Include="AutomatedTestsUtc=$(_SynixAutomatedTestsUtc)" />
			<_SynixReleaseManifestLine Include="SecurityRegressionReview=Passed" />
			<_SynixReleaseManifestLine Include="SecurityRegressionReviewUtc=$(_SynixAutomatedTestsUtc)" />
			<_SynixReleaseManifestLine Include="StandaloneFile=$(AssemblyName).exe" />
			<_SynixReleaseManifestLine Include="StandaloneSha256=$(_SynixStandaloneSha256)" />
			<_SynixReleaseManifestLine Include="MsiFile=SynixSetup.msi" />
			<_SynixReleaseManifestLine Include="MsiSha256=$(_SynixMsiSha256)" />
		</ItemGroup>
		<WriteLinesToFile File="$(_SynixReleaseManifest)" Lines="@(_SynixReleaseManifestLine)" Overwrite="true" Encoding="UTF-8" />
		<Copy SourceFiles="$(_SynixReleaseManifest)" DestinationFiles="$(_SynixReleaseManifestBackup)" />
		<Error Condition="!Exists('$(_SynixReleaseManifest)')" Text="The Synix release manifest was not created at $(_SynixReleaseManifest)." />
		<Error Condition="!Exists('$(_SynixReleaseManifestBackup)')" Text="The backup release manifest was not created at $(_SynixReleaseManifestBackup)." />
		<Message Text="Synix release manifest created at $(_SynixReleaseManifest)." Importance="high" />
	</Target>
</Project>
