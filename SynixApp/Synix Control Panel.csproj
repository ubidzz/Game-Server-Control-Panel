<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>Synix_Control_Panel</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>Images\Synix_logo_Icon.ico</ApplicationIcon>
		<AssemblyName>Synix Control Panel</AssemblyName>
		<AssemblyTitle>Synix</AssemblyTitle>
		<PackageProjectUrl>https://github.com/ubidzz/Synix-Control-Panel/blob/master/README.md</PackageProjectUrl>
		<Copyright>Copyright © 2026 Jason Turner (ubidzz). All Rights Reserved.</Copyright>
		<Description>PC Game Server Hosting</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/ubidzz/Synix-Control-Panel</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Version>1.0.25</Version>
		<AssemblyVersion>$(Version).0</AssemblyVersion>
		<FileVersion>$(Version).0</FileVersion>
		<InformationalVersion>$(Version)</InformationalVersion>
		<SynixBuildChannel Condition="'$(SynixBuildChannel)' == '' and ('$(_IsPublishing)' == 'true' or '$(PublishProfile)' != '' or '$(WebPublishProfileFile)' != '')">Stable</SynixBuildChannel>
		<SynixBuildChannel Condition="'$(SynixBuildChannel)' == ''">Development</SynixBuildChannel>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and ('$(_IsPublishing)' == 'true' or '$(PublishProfile)' != '' or '$(WebPublishProfileFile)' != '')">win-x64</RuntimeIdentifier>
		<SelfContained Condition="'$(SelfContained)' == '' and ('$(_IsPublishing)' == 'true' or '$(PublishProfile)' != '' or '$(WebPublishProfileFile)' != '')">true</SelfContained>
		<DefineConstants Condition="'$(SynixBuildChannel)' == 'Stable'">$(DefineConstants);SYNIX_STABLE_RELEASE</DefineConstants>
		<NeutralLanguage>en-US</NeutralLanguage>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<DebugType Condition="'$(Configuration)' != 'Debug'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' != 'Debug'">false</DebugSymbols>
		<PackageIcon>SyniX logo with glowing accents.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="SynixApp\**" />
	  <Compile Remove="Tests\**" />
	  <EmbeddedResource Remove="SynixApp\**" />
	  <EmbeddedResource Remove="Tests\**" />
	  <None Remove="SynixApp\**" />
	  <None Remove="Tests\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="SynixEngine\version.txt" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="Images\SyniX logo.ico" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="SynixEngine\version.txt" />
	  <EmbeddedResource Include="Database\GameDefinitions\**\*.game.json" />
	  <EmbeddedResource Include="Database\GameDefinitions\**\Templates\**\*" />
	  <EmbeddedResource Update="Database\GameDefinitions\7-days-to-die\Templates\serverconfig.xml">
	    <LogicalName>Synix.GameDefinitions.SevenDaysToDie.serverconfig.xml</LogicalName>
	  </EmbeddedResource>
	  <EmbeddedResource Include="Database\GameDefinitions\game-verification.json" />
	  <EmbeddedResource Include="Database\ModSystems\**\*.modsystem.json" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyMetadata Include="SynixBuildChannel" Value="$(SynixBuildChannel)" />
		<InternalsVisibleTo Include="Synix.Tests" />
		<PackageReference Include="System.Management" Version="10.0.7" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="UI\Dashboard\MainGUI.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="UI\ServerManagement\SatisfactoryControlDialog.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="UI\ServerManagement\SatisfactoryControlDialog.Designer.cs">
	    <DependentUpon>SatisfactoryControlDialog.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\Dashboard\MainGUI.Designer.cs">
	    <DependentUpon>MainGUI.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\Settings\GeneralSettingsPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\Settings\GeneralSettingsPage.Designer.cs">
	    <DependentUpon>GeneralSettingsPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsGeneralPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsReviewPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsReviewPage.Designer.cs">
	    <DependentUpon>ServerSettingsReviewPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsGeneralPage.Designer.cs">
	    <DependentUpon>ServerSettingsGeneralPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsSecurityPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsSecurityPage.Designer.cs">
	    <DependentUpon>ServerSettingsSecurityPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsWorldPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsWorldPage.Designer.cs">
	    <DependentUpon>ServerSettingsWorldPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsNetworkPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsNetworkPage.Designer.cs">
	    <DependentUpon>ServerSettingsNetworkPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsAutomationPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsAutomationPage.Designer.cs">
	    <DependentUpon>ServerSettingsAutomationPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsInstallPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\ServerSetup\ServerSettingsInstallPage.Designer.cs">
	    <DependentUpon>ServerSettingsInstallPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\Settings\BackupSettingsPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\Settings\BackupSettingsPage.Designer.cs">
	    <DependentUpon>BackupSettingsPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\Settings\PrivacySettingsPage.cs">
	    <SubType>UserControl</SubType>
	  </Compile>
	  <Compile Update="UI\Settings\PrivacySettingsPage.Designer.cs">
	    <DependentUpon>PrivacySettingsPage.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\Settings\AdvancedSettingsPage.cs">
