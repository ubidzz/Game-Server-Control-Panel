	  <Compile Update="UI\GameDefinitions\ArgumentVerificationDialog.Designer.cs">
	    <DependentUpon>ArgumentVerificationDialog.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\Diagnostics\TroubleshooterDialog.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="UI\Diagnostics\TroubleshooterDialog.Designer.cs">
	    <DependentUpon>TroubleshooterDialog.cs</DependentUpon>
	  </Compile>
	  <Compile Update="UI\ServerManagement\ConnectionInformationDialog.cs">
	    <SubType>Form</SubType>
	  </Compile>
	  <Compile Update="UI\ServerManagement\ModPluginManager.cs">
